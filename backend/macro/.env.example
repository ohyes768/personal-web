# FRED API 配置
FRED_API_KEY=your_fred_api_key_here

# 服务配置
SERVICE_PORT=8094
SERVICE_HOST=0.0.0.0

# 数据配置
DATA_DIR=./data
HISTORICAL_START_DATE=2000-01-01

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=1.0

# 阿里云市场 API（商品数据：黄金/白银/原油/铜）
# 在阿里云市场购买 alirmcom2 API 后，将 AppCode 填到下方
# 参考 dividend-select：base_url 用 http（非 https），商品走 comkm K线接口
ALIYUN_API_APPCODE=
ALIRMCOM_BASE_URL=http://alirmcom2.market.alicloudapi.com

# Chart analysis (all secrets server-side; empty means unavailable)
ANALYSIS_PASSWORD=
# Generate a long random secret separately from the unlock password.
ANALYSIS_SIGNING_SECRET=
ANALYSIS_COOKIE_SECURE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ANALYSIS_TIMEOUT_SECONDS=90
# Local HTTP development only: ANALYSIS_COOKIE_SECURE=false
