# 本地开发配置模板：复制为 .env.local 后填写（.env*.local 已被 gitignore）
# 生产部署不读这个文件，配置写在 NAS 仓库根 .env 里。

# 管理口令（必填，缺失后端拒绝启动）
SERVICE_MANAGER_ADMIN_PASSWORD=换成你自己的口令

# 会话签名密钥（必填，随便一串足够长的随机字符串；轮换会让所有会话失效）
SERVICE_MANAGER_SESSION_SECRET=换成一段随机字符串

# 数据目录（SQLite 台账 + 恢复前备份）
SERVICE_MANAGER_DATA_DIR=./data

# 本机 Docker：直接用 unix socket；容器部署时改成 socket-proxy 的 tcp 地址
SERVICE_MANAGER_DOCKER_HOST=unix:///var/run/docker.sock

# 本地 http 访问必须关闭 Secure cookie，否则浏览器不会回传会话
SERVICE_MANAGER_SECURE_COOKIE=false

# 同源允许列表（写请求校验用）；本地一般留空即可，Origin==Host 会自动通过
SERVICE_MANAGER_PUBLIC_ORIGIN=http://127.0.0.1:3012

# GitHub Release 检查（可选；公开仓库不需要 token，限流更严）
# SERVICE_MANAGER_GITHUB_TOKEN=

# 本地开发建议关掉后台调度，检查改为手动触发
SERVICE_MANAGER_SCHEDULER_ENABLED=false
