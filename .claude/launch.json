{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kids-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/kids-catalog", "dev"],
      "port": 3009
    },
    {
      "name": "skill-manager-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/skill-manager", "dev"],
      "port": 3008
    },
    {
      "name": "rss-relay-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/rss-relay", "dev"],
      "port": 3006
    },
    {
      "name": "rss-relay-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend/rss-relay", "uvicorn", "src.main:app", "--host", "127.0.0.1", "--port", "8099", "--no-access-log"],
      "port": 8099
    },
    {
      "name": "housing-map-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/housing-map", "dev"],
      "port": 3007
    },
    {
      "name": "housing-map-api",
      "runtimeExecutable": "backend/housing-map/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--app-dir", "backend/housing-map", "--host", "0.0.0.0", "--port", "8096"],
      "port": 8096
    },
    {
      "name": "dividend-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/dividend", "dev"],
      "port": 3003
    },
    {
      "name": "dividend-web-attach",
      "url": "http://localhost:3003"
    },
    {
      "name": "home-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4010", "--directory", "nginx/html"],
      "port": 4010
    },
    {
      "name": "boundary-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8917", "--directory", "backend/housing-map/estimate_out"],
      "port": 8917
    }
  ]
}
